{
  "name": "slicksvg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bake": "bun run build",
    "build": "bun ./tests/validate-css.js && vite build && mv dist/src/index.html dist/index.html && rmdir dist/src",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run check && npm run check:e2e",
		"test:unit": "npm run check",
		"test:integration": "npm run check:coverage",
		"test:e2e": "start-server-and-test preview http://localhost:4173 check:e2e",
		"test:all": "npm run check && npm run check:coverage && npm run check:e2e",
		"preview": "vite preview --host --port 4173",
		"check": "vitest run",
		"check:coverage": "vitest run --coverage",
    "check:e2e": "bunx playwright test --reporter=line --workers=2",
    "check:e2e:headed": "playwright test --headed --workers=2",
    "check:e2e:debug": "playwright test --debug --workers=2",
    "check:e2e:ui": "playwright test --ui",
    "playwright:install": "npx playwright install",
    "playwright:install-deps": "npx playwright install-deps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@vitest/coverage-v8": "5.0.5",
    "cssnano": "^9.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fsegurai/codemirror-theme-tokyo-night-day": "^6.2.7",
    "@fsegurai/codemirror-theme-tokyo-night-storm": "^6.2.7",
    "codemirror": "^6.0.2"
  }
}
